# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Flask (REQUIRED — app will not start without SECRET_KEY) ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=""
FRONTEND_URL="http://localhost:5000"
# Set to "production" on deployed hosts
FLASK_ENV="development"

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Groq (the AI "brain") ---
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# --- SMTP (optional fallback for OTP emails) ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-address@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Aether <your-address@gmail.com>"
SMTP_USE_TLS="true"

# --- Brevo (preferred for transactional email) ---
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="your-verified-sender@example.com"
BREVO_SENDER_NAME="Aether"
