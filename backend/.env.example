# --- Database (Neon Postgres) ---
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Flask ---
SECRET_KEY="generate-with: python -c \"import secrets; print(secrets.token_hex(32))\""
FRONTEND_URL="http://localhost:5000"

# --- Google OAuth (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Groq (the AI "brain") ---
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# --- SMTP (for "forgot password" OTP emails) ---
# Preferred: use Brevo's API (BREVO_API_KEY below). If that's not set, this
# SMTP block is used instead. If neither is set, OTP codes are printed to
# the backend console, which is handy for local development.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-address@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="Aether <your-address@gmail.com>"
SMTP_USE_TLS="true"

# --- Brevo (transactional email API — preferred over raw SMTP) ---
BREVO_API_KEY="xkeysib-..."
BREVO_SENDER_EMAIL="your-verified-sender@example.com"
BREVO_SENDER_NAME="Aether"
